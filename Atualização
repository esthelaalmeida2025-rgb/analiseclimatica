  P.forEach((p,i)=>{const t=(p.v-lo)/(hi-lo); const rad=5+t*9; ctx.beginPath();ctx.arc(p.x,p.y,rad,0,Math.PI*2); ctx.fillStyle=escalaCor(esc,t); ctx.fill(); ctx.strokeStyle='#0B4D40'; ctx.lineWidth=1.5; ctx.stroke();
    if(rot){const txt=pontos[i].s.name.replace('Sao Paulo - ','SP ').replace(' Do ',' do ').replace(' De ',' de '); ctx.fillStyle='#1F2A26'; ctx.lineWidth=3; ctx.strokeStyle='rgba(248,243,227,.85)'; ctx.strokeText(txt,p.x+rad+3,p.y+4); ctx.fillText(txt,p.x+rad+3,p.y+4);} });
  // título
