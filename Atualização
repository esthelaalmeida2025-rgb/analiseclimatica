function mask(W,H){ const key=UF+'_'+W+'x'+H; if(MASKS[key]) return MASKS[key]; const poly=UF==='MG'?MG:SP; const pts=poly.map(p=>proj(p[0],p[1],W,H)); const cols=Math.ceil(W/GS), rows=Math.ceil(H/GS); const M=new Uint8Array(cols*rows); for(let r=0;r<rows;r++)for(let c=0;c<cols;c++) M[r*cols+c]=pip(c*GS+GS/2,r*GS+GS/2,pts)?1:0; M.cols=cols;M.rows=rows;M.pts=pts; MASKS[key]=M; return M; }
