function desenharMapa(canvas, pontos, titulo, modo){
  const W=canvas.width,H=canvas.height,ctx=canvas.getContext('2d'); const V=VARS[S.var]; const M=mask(W,H);
  ctx.fillStyle='#F8F3E3'; ctx.fillRect(0,0,W,H);
  if(!pontos.length){ctx.fillStyle='#6F7A75';ctx.font='16px Manrope';ctx.fillText('Sem dados para esta seleção.',30,40);return null;}
  const vals=pontos.map(p=>p.v); let lo=Math.min(...vals),hi=Math.max(...vals); let esc=V.esc;
  if(modo==='anomalia'){const m=Math.max(Math.abs(lo),Math.abs(hi))||1; lo=-m;hi=m;esc='anom';}
