<script>
// ============ DADOS ============
const D = JSON.parse(document.getElementById('dados').textContent);
const SP = JSON.parse(document.getElementById('sp-geo').textContent);
const MG = JSON.parse(document.getElementById('mg-geo').textContent);
const F = D.meta.fields; const FI = Object.fromEntries(F.map((f,i)=>[f,i]));
const MESES = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
const MESES_L = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
const ANOS = [...new Set(D.meta.months.map(m=>m.slice(0,4)))];
const EST_ALL = D.stations;
let UF = 'SP';
let EST = EST_ALL.filter(s=>(s.uf||'SP')===UF);
const PAL_ANO=['#9DB4A0','#6E9C8B','#2E8A72','#4E9F8A','#166B59','#0B4D40','#7B7F6A','#5B8FB9'];
const CORES_ANO = {}; ANOS.forEach((a,i)=>CORES_ANO[a]=i===ANOS.length-1?'#C8553D':i===ANOS.length-2?'#D99A26':PAL_ANO[i%PAL_ANO.length]);
const VARS = {
  prec:{rot:'Chuva acumulada',un:'mm',agg:'sum',cor:'var(--chuva)',hex:'#2E7DA1',esc:'chuva',dec:0},
  dias_chuva:{rot:'Dias com chuva (≥1 mm)',un:'dias',agg:'sum',hex:'#2E7DA1',esc:'chuva',dec:0},
  pmax_dia:{rot:'Maior chuva em 24 h',un:'mm',agg:'max',hex:'#2E7DA1',esc:'chuva',dec:1},
  tmed:{rot:'Temperatura média',un:'°C',agg:'mean',hex:'#8C6D46',esc:'temp',dec:1},
  tmax_med:{rot:'Temperatura máxima média',un:'°C',agg:'mean',hex:'#C8553D',esc:'temp',dec:1},
  tmin_med:{rot:'Temperatura mínima média',un:'°C',agg:'mean',hex:'#5B8FB9',esc:'temp',dec:1},
  tmax_abs:{rot:'Máxima absoluta',un:'°C',agg:'max',hex:'#C8553D',esc:'temp',dec:1},
  tmin_abs:{rot:'Mínima absoluta',un:'°C',agg:'min',hex:'#5B8FB9',esc:'temp',dec:1},
  dias_geada:{rot:'Dias com risco de geada (Tmín ≤3 °C)',un:'dias',agg:'sum',hex:'#7A9CC6',esc:'frio',dec:0},
  dias_calor:{rot:'Dias de calor (Tmáx ≥32 °C)',un:'dias',agg:'sum',hex:'#C8553D',esc:'temp',dec:0},
  umid:{rot:'Umidade relativa média',un:'%',agg:'mean',hex:'#4E9F8A',esc:'umid',dec:0},
  umin:{rot:'Umidade relativa mínima',un:'%',agg:'min',hex:'#4E9F8A',esc:'umid',dec:0},
  rad:{rot:'Radiação global (média diária)',un:'MJ/m²',agg:'mean',hex:'#D99A26',esc:'rad',dec:1},
  vel:{rot:'Vento médio',un:'m/s',agg:'mean',hex:'#7B7F6A',esc:'vento',dec:1},
  raj:{rot:'Rajada máxima',un:'m/s',agg:'max',hex:'#7B7F6A',esc:'vento',dec:1},
};
// grupos regionais (aproximação por coordenadas)
function regiaoSP(s){
  const {lat,lon}=s;
  if(lat<-24.2||(lat<-23.6&&lon>-47.0&&lon<-46.0&&s.code!=='A771'&&s.code!=='A755')) return 'Litoral e Vale do Ribeira';
  if(lon<-50.3) return 'Oeste paulista';
  if(lat>-21.6&&lon>-50.3) return 'Norte paulista';
  if(lon>-46.3) return 'Vale do Paraíba e Mantiqueira';
  if(lat<-22.9&&lon<-47.4) return 'Sudoeste paulista';
  if(lat<-23.2) return 'Região metropolitana';
  return 'Centro paulista';
}
// aproximação por coordenadas das mesorregiões de MG (limites simplificados — refinar quando os
// códigos reais das estações mineiras estiverem no painel)
function regiaoMG(s){
  const {lat,lon}=s;
  if(lat>=-17.0) return 'Norte de Minas, Jequitinhonha e Mucuri';
  if(lon<=-47.3) return 'Triângulo Mineiro e Alto Paranaíba';
  if(lat<=-20.6&&lon<=-45.3) return 'Sul e Sudoeste de Minas';
  if(lon>=-43.6) return 'Zona da Mata e Vale do Rio Doce';
  if(lat<=-20.0) return 'Oeste e Centro-Oeste de Minas';
  return 'Região Metropolitana de BH e Campo das Vertentes';
}
EST_ALL.forEach(s=>{ s.reg = s.uf==='MG' ? regiaoMG(s) : regiaoSP(s); });
// fix: coastal ones (só SP)
['A765','A712','A766','A746','A767'].forEach(c=>{const s=EST_ALL.find(x=>x.code===c&&x.uf!=='MG'); if(s) s.reg='Litoral e Vale do Ribeira';});
['A701','A771','A755','A744'].forEach(c=>{const s=EST_ALL.find(x=>x.code===c&&x.uf!=='MG'); if(s) s.reg='Região metropolitana';});
let REGS=[], GRUPOS={};
function recomputarGrupos(){
  REGS=[...new Set(EST.map(s=>s.reg))].sort();
  GRUPOS={};
  GRUPOS[`Todas as estações (média ${UF})`]=EST.map(s=>s.code);
  if(UF==='SP') GRUPOS['Região de Itapetininga (Itapeva, S. Miguel Arcanjo, Iperó, Avaré)']=['A714','A715','A713','A725'];
  REGS.forEach(r=>GRUPOS['Região: '+r]=EST.filter(s=>s.reg===r).map(s=>s.code));
}
recomputarGrupos();

// ============ ESTADO ============
const S = {est:'A714', var:'prec', anos:ANOS.slice(-3), per:'ano', mi:0, mf:11, tipo:'bar', acum:false, aba:'visao', mapaModo:'valor'};
const $=id=>document.getElementById(id);
const fmt=(v,d=1)=>v==null||isNaN(v)?'–':Number(v).toLocaleString('pt-BR',{minimumFractionDigits:d,maximumFractionDigits:d});

// ============ HELPERS ============
function mesesPeriodo(){ if(S.per==='ano') return [...Array(12).keys()]; if(S.per==='seco') return [3,4,5,6,7,8]; if(S.per==='chuvoso') return [9,10,11,0,1,2]; const a=[]; for(let i=S.mi;i<=S.mf;i++) a.push(i); return a; }
function perTexto(){ return S.per==='ano'?'ano todo':S.per==='seco'?'abr–set':S.per==='chuvoso'?'out–mar (out–dez do ano + jan–mar seguinte)':`${MESES[S.mi]}–${MESES[S.mf]}`; }
function codigos(){ return GRUPOS[S.est] ? GRUPOS[S.est] : [S.est]; }
function nomeEst(){ if(GRUPOS[S.est]) return S.est; const s=EST.find(x=>x.code===S.est); return s?`${s.name} (${s.code})`:S.est; }
// valor mensal de uma estação: v(code, 'YYYY-MM', var)
function vm(code, ym, v){ const s=EST.find(x=>x.code===code); const r=s&&s.m[ym]; return r?r[FI[v]]:null; }
// valor mensal agregado de várias estações (média)
function vmG(codes, ym, v){ const a=codes.map(c=>vm(c,ym,v)).filter(x=>x!=null); return a.length?a.reduce((p,q)=>p+q,0)/a.length:null; }
// meses (YYYY-MM) do período para um ano; chuvoso cruza ano
function ymsPeriodo(ano){ const ms=mesesPeriodo(); if(S.per==='chuvoso'){ return ms.map(m=>m>=9?`${ano}-${String(m+1).padStart(2,'0')}`:`${+ano+1}-${String(m+1).padStart(2,'0')}`);} return ms.map(m=>`${ano}-${String(m+1).padStart(2,'0')}`); }
function agg(vals, tipo){ const a=vals.filter(x=>x!=null); if(!a.length) return null; if(tipo==='sum') return a.reduce((p,q)=>p+q,0); if(tipo==='mean') return a.reduce((p,q)=>p+q,0)/a.length; if(tipo==='max') return Math.max(...a); if(tipo==='min') return Math.min(...a); }
// agregado do período para um ano
function vPer(codes, ano, v, soMeses=null){ let yms=ymsPeriodo(ano); if(soMeses) yms=yms.filter(ym=>soMeses.includes(+ym.slice(5)-1)); const vals=yms.map(ym=>vmG(codes,ym,v)); return agg(vals,VARS[v].agg); }
// meses (0-11) do período com dado disponível para o ano
function mesesDisp(codes, ano, v){ return ymsPeriodo(ano).filter(ym=>vmG(codes,ym,v)!=null).map(ym=>+ym.slice(5)-1); }
function parcial(codes, ano, v){ const md=mesesDisp(codes,ano,v); return md.length && md.length<mesesPeriodo().length ? md : null; }
function anoFoco(){ return S.anos.length?S.anos[S.anos.length-1]:ANOS[ANOS.length-1]; }
function mediaOutros(codes, v, anoFoco){ const md=parcial(codes,anoFoco,v); const outros=ANOS.filter(a=>a!==anoFoco).map(a=>vPer(codes,a,v,md)).filter(x=>x!=null); return outros.length?outros.reduce((p,q)=>p+q,0)/outros.length:null; }
// média histórica mensal (climatologia) de um mês (0-11)
function climMes(codes, m, v, excluir){ const vals=ANOS.filter(a=>a!==excluir).map(a=>vmG(codes,`${a}-${String(m+1).padStart(2,'0')}`,v)).filter(x=>x!=null); return vals.length?vals.reduce((p,q)=>p+q,0)/vals.length:null; }
function minMaxMes(codes,m,v){ const vals=ANOS.map(a=>vmG(codes,`${a}-${String(m+1).padStart(2,'0')}`,v)).filter(x=>x!=null); return vals.length?[Math.min(...vals),Math.max(...vals)]:[null,null]; }

// ============ UI INIT ============
function popularEstacoes(){
  const se=$('sel-est'); se.innerHTML='';
  const og1=document.createElement('optgroup'); og1.label='Grupos';
  Object.keys(GRUPOS).forEach(g=>{const o=document.createElement('option');o.value=g;o.textContent=g;og1.appendChild(o);}); se.appendChild(og1);
  REGS.forEach(r=>{const og=document.createElement('optgroup'); og.label=r; EST.filter(s=>s.reg===r).forEach(s=>{const o=document.createElement('option');o.value=s.code;o.textContent=`${s.name} (${s.code})`;og.appendChild(o);}); se.appendChild(og);});
  se.value=S.est;
}
function bboxFromPoly(poly){
  let lonMin=Infinity,lonMax=-Infinity,latMin=Infinity,latMax=-Infinity;
  poly.forEach(([lon,lat])=>{ if(lon<lonMin)lonMin=lon; if(lon>lonMax)lonMax=lon; if(lat<latMin)latMin=lat; if(lat>latMax)latMax=lat; });
  const padLon=(lonMax-lonMin)*0.04, padLat=(latMax-latMin)*0.04;
  return {lonMin:lonMin-padLon,lonMax:lonMax+padLon,latMin:latMin-padLat,latMax:latMax+padLat};
}
function atualizarCabecalho(){
  $('logo-uf').textContent=UF;
  $('titulo-uf').textContent=`Painel Climático INMET · Estado de ${UF==='MG'?'Minas Gerais':'São Paulo'}`;
  document.title=`Painel Climático INMET · ${UF==='MG'?'Minas Gerais':'São Paulo'} 2020–2026`;
  $('rodape-uf').textContent=`Painel Climático INMET · ${UF==='MG'?'Minas Gerais':'São Paulo'}`;
  const m0=D.meta.months[0], m1=D.meta.months[D.meta.months.length-1]; const fm=ym=>`${MESES_L[+ym.slice(5)-1].slice(0,3)}/${ym.slice(0,4)}`;
  const falt=(D.meta.anos_faltantes||[]);
  $('sub-periodo').textContent=`Estações automáticas do INMET, ${fm(m0)} a ${fm(m1)} · ${EST.length} estações de ${UF}${falt.length?` · sem dados para ${falt.join(', ')}`:''}`;
  $('mapa-desc').textContent=`Interpolação (IDW) entre as ${EST.length} estações do INMET em ${UF==='MG'?'Minas Gerais':'São Paulo'} para a variável e o período escolhidos. Círculos são as estações; o tamanho acompanha o valor. Passe o mouse para ver o valor de cada estação.`;
  $('nota-fonte').innerHTML=`Fonte: INMET, dados horários das estações automáticas (BDMEP), ${EST.length} estações do estado de ${UF==='MG'?'Minas Gerais':'São Paulo'}. Agregação: chuva = soma horária → soma diária → soma mensal; temperaturas = médias diárias e extremos absolutos do mês; umidade e vento = média horária; radiação = soma diária em MJ/m² e média mensal desse total. Dia considerado válido com ≥18 horas de leitura; mês válido com ≥80% dos dias (chuva) ou ≥70% (temperatura). Meses com cobertura insuficiente ficam em branco. Atualização automática semanal a partir de portal.inmet.gov.br/dadoshistoricos.${UF==='SP'?' Estações com série curta: Bebedouro e Ourinhos (sem 2025), São Sebastião e Votuporanga (a partir de 2025).':''}`;
}
function trocarUF(uf){
  if(uf===UF) return;
  UF=uf;
  EST=EST_ALL.filter(s=>(s.uf||'SP')===UF);
  BB=bboxFromPoly(UF==='MG'?MG:SP);
  recomputarGrupos();
  S.est=`Todas as estações (média ${UF})`;
  popularEstacoes();
  document.querySelectorAll('.aba-uf').forEach(b=>b.classList.toggle('on',b.dataset.uf===UF));
  atualizarCabecalho();
  render();
}
function initUI(){
  popularEstacoes();
  document.querySelectorAll('.aba-uf').forEach(b=>b.onclick=()=>trocarUF(b.dataset.uf));
  const sv=$('sel-var'); Object.entries(VARS).forEach(([k,v])=>{const o=document.createElement('option');o.value=k;o.textContent=`${v.rot} (${v.un})`;sv.appendChild(o);}); sv.value=S.var;
  const ca=$('chips-anos'); ANOS.forEach(a=>{const c=document.createElement('span');c.className='chip'+(S.anos.includes(a)?' on':'');c.textContent=a;c.dataset.a=a;c.onclick=()=>{c.classList.toggle('on'); S.anos=[...ca.querySelectorAll('.chip.on')].map(x=>x.dataset.a); if(!S.anos.length){c.classList.add('on');S.anos=[a];} render();}; ca.appendChild(c);});
  $('chips-per').querySelectorAll('.chip').forEach(c=>c.onclick=()=>{$('chips-per').querySelectorAll('.chip').forEach(x=>x.classList.remove('on'));c.classList.add('on');S.per=c.dataset.p;$('campo-custom').style.display=S.per==='custom'?'':'none';render();});
  [$('mes-ini'),$('mes-fim')].forEach((s,i)=>{MESES.forEach((m,j)=>{const o=document.createElement('option');o.value=j;o.textContent=m;s.appendChild(o);}); s.value=i?11:0; s.onchange=()=>{S.mi=+$('mes-ini').value;S.mf=+$('mes-fim').value;if(S.mf<S.mi){S.mf=S.mi;$('mes-fim').value=S.mi;}render();};});
