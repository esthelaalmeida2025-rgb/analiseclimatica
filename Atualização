    for(let yy=r*GS;yy<Math.min(H,r*GS+GS);yy++)for(let xx=c*GS;xx<Math.min(W,c*GS+GS);xx++){const i=(yy*W+xx)*4;dat[i]=col[0];dat[i+1]=col[1];dat[i+2]=col[2];dat[i+3]=255;} }
