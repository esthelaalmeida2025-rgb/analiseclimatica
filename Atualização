function hex2rgb(h){return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];}
function escalaCor(nome,t,alpha=1){ const st=ESCALAS[nome]; t=Math.max(0,Math.min(1,t)); const x=t*(st.length-1); const i=Math.min(Math.floor(x),st.length-2); const f=x-i; const a=hex2rgb(st[i]),b=hex2rgb(st[i+1]); const c=a.map((v,k)=>Math.round(v+(b[k]-v)*f)); return `rgba(${c[0]},${c[1]},${c[2]},${alpha})`; }
let BB=bboxFromPoly(SP);
function proj(lon,lat,W,H){ const pad=20; const sx=(W-2*pad)/(BB.lonMax-BB.lonMin), sy=(H-2*pad)/(BB.latMax-BB.latMin); const s=Math.min(sx,sy*1.0); return [pad+(lon-BB.lonMin)*s, pad+(BB.latMax-lat)*s]; }
